---
interface Props {
	src: string;
	title: string;
}

const { src, title } = Astro.props;
---

<div class="w-full overflow-hidden rounded border border-accent-2">
	<iframe
		src={src}
		title={title}
		class="block w-full border-0"
		style="height: 80vh; min-height: 600px;"
		loading="lazy"
	></iframe>
</div>