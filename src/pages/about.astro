---
import { getEntry, render } from "astro:content";
import PageLayout from "@/layouts/Base.astro";

const about = await getEntry("page", "about");
if (!about) throw new Error("Missing content/pages/about.md");
const { Content } = await render(about);
---

<PageLayout meta={{ description: about.data.description ?? "", title: about.data.title }}>
	<h1 class="title mb-12">{about.data.title}</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<Content />
	</div>
</PageLayout>
