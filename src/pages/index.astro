---
import { type CollectionEntry, getCollection, getEntry, render } from "astro:content";
import SocialList from "@/components/SocialList.astro";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

const MAX_PROJECTS = 5;
const home = await getEntry("page", "home");
if (!home) throw new Error("Missing content/pages/home.md");
const { Content } = await render(home);
const allProjects = await getCollection("project");
const selectedProjectIds = new Set(home.data.featuredProjects);
const selectedPaperIds = new Set(home.data.featuredPapers);
const latestProjects = allProjects
	.filter((project) => selectedProjectIds.has(project.id))
	.sort(collectionDateSort)
	.slice(0, MAX_PROJECTS) as CollectionEntry<"project">[];
const papers = allProjects.filter((project) => selectedPaperIds.has(project.id));
---

<PageLayout meta={{ description: home.data.description ?? "", title: home.data.title }}>
	<section class="prose prose-sm prose-cactus mb-8 max-w-none [&>h1]:mb-6">
		<Content />
	</section>
	<div class="mb-30">
		<SocialList />
	</div>
	{
		latestProjects.length > 0 && (
			<section>
				<ul class="space-y-4" role="list">
					{latestProjects.map((project) => (
						<li class="grid gap-1 sm:grid-cols-[9rem_1fr] sm:grid-rows-[1rem_1fr] sm:gap-0">
							<time datetime={project.data.sortDate.toISOString()}>{project.data.date}</time>
							<a class="cactus-link" href={`/projects/${project.id}/`}>
								{project.data.title}
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}
	{
		papers.length > 0 && (
			<ul class="mt-15 list-inside list-disc space-y-2" aria-label="Publications">
				{papers.map((paper) => (
					<li>
						<span>{paper.data.date}: </span>
						<a class="cactus-link" href={`/projects/${paper.id}/`}>
							{paper.data.title}
						</a>
					</li>
				))}
			</ul>
		)
	}
</PageLayout>
