---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Curriculum vitae",
	title: "CV",
};
---

<PageLayout meta={meta}>
	<section>
		<div class="mb-6 flex items-center justify-between gap-4">
			<h1 class="title">CV</h1>
			<a class="cactus-link" href="/cv/cv.pdf" download="Abhijeet-Vikram-CV.pdf">Download PDF</a>
		</div>
		<iframe
			class="w-full rounded border border-accent-2"
			height="1000"
			src="/cv/view.pdf"
			style="min-height: 75vh"
			title="Abhijeet Vikram's CV"
		></iframe>
	</section>
</PageLayout>
