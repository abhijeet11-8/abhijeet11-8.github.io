---
import { type CollectionEntry, getCollection, getEntry, render } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import Pagination from "@/components/Paginator.astro";
import Project from "@/components/project/Project.astro";
import PageLayout from "@/layouts/Base.astro";

export const getStaticPaths = (async ({ paginate }) => {
	const allProjects = await getCollection("project");
	const projectPage = await getEntry("page", "projects");
	const customOrder = projectPage?.data.featuredProjects ?? [];
	const projectMap = new Map(allProjects.map((project) => [project.id, project]));
	const orderedProjects = customOrder.length
		? customOrder
			.map((projectId) => projectMap.get(projectId))
			.filter((project): project is CollectionEntry<"project"> => Boolean(project))
			.concat(allProjects.filter((project) => !customOrder.includes(project.id)))
		: allProjects;
	return paginate(orderedProjects, { pageSize: 10 });
}) satisfies GetStaticPaths;

const projectPage = await getEntry("page", "projects");
if (!projectPage) throw new Error("Missing content/pages/projects.md");
const { Content } = await render(projectPage);
const { page } = Astro.props as { page: Page<CollectionEntry<"project">> };
const miniPage = await getEntry("page", "mini-projects");
const miniProjects = await getCollection("miniProject");
const miniProjectOrder = miniPage?.data.featuredMiniProjects ?? [];
const miniProjectMap = new Map(miniProjects.map((project) => [project.id, project]));
const sortedMiniProjects = miniProjectOrder.length
	? miniProjectOrder
		.map((projectId) => miniProjectMap.get(projectId))
		.filter((project): project is CollectionEntry<"miniProject"> => Boolean(project))
		.concat(miniProjects.filter((project) => !miniProjectOrder.includes(project.id)))
	: miniProjects;
const projectMap = new Map((await getCollection("project")).map((project) => [project.id, project]));
const paperProjects = (projectPage.data.featuredPapers ?? [])
	.map((paperId) => projectMap.get(paperId))
	.filter((project): project is CollectionEntry<"project"> => Boolean(project));
const highlightedProjectIds = new Set(projectPage.data.highlightedProjects ?? []);
---

<PageLayout meta={{ description: projectPage.data.description ?? "A collection of my projects", title: projectPage.data.title ?? "Projects" }}>
	<section class="prose prose-sm prose-cactus mb-8 max-w-none [&>h1]:mb-6">
		<Content />
	</section>
	<div class="mb-8 flex justify-end">
		<a
			class="cactus-link inline-flex items-center gap-2"
			href="/projects/"
			onclick="document.getElementById('mini-projects')?.scrollIntoView({ behavior: 'smooth', block: 'start' }); return false;"
		>
			<span>Mini-projects</span>
			<span aria-hidden="true">↓</span>
		</a>
	</div>
	<section>
		<h1 class="title mb-12">Projects</h1>
		<ul class="space-y-8 text-start">
			{page.data.map((project) => (
				<li><Project project={project} as="h2" isPreview /></li>
			))}
		</ul>
		<Pagination
			{...(page.url.prev && { prevUrl: { text: "← Previous Page", url: page.url.prev } })}
			{...(page.url.next && { nextUrl: { text: "Next Page →", url: page.url.next } })}
		/>
	</section>

	<section class="mt-16" id="mini-projects">
		<h2 class="title mb-6">Mini-projects</h2>
		{sortedMiniProjects.length > 0 ? (
			<ul class="space-y-4 text-start">
				{sortedMiniProjects.map((project) => (
					<li class="bg-global-text/5 rounded-md px-4 py-3">
						<time datetime={project.data.sortDate.toISOString()} class="mb-1 block text-sm text-muted">
							{project.data.date}
						</time>
						<a
							class:list={["cactus-link font-semibold", highlightedProjectIds.has(project.id) && "theme-inline-accent"]}
							href={`/mini-projects/${project.id}/`}
						>
							{project.data.title}
						</a>
						<p class="mt-1 text-sm text-muted">{project.data.description ?? "Mini-project"}</p>
					</li>
				))}
			</ul>
		) : (
			<p class="text-muted">Nothing here yet!</p>
		)}
	</section>

	{paperProjects.length > 0 && (
		<section class="mt-16">
			<h2 class="title mb-6">Papers</h2>
			<ul class="space-y-4 text-start">
				{paperProjects.map((project) => (
					<li class="bg-global-text/5 rounded-md px-4 py-3">
						<time datetime={project.data.sortDate.toISOString()} class="mb-1 block text-sm text-muted">
							{project.data.date}
						</time>
						<a class="cactus-link font-semibold" href={`/projects/${project.id}/`}>
							{project.data.title}
						</a>
						<p class="mt-1 text-sm text-muted">{project.data.description ?? "Paper"}</p>
					</li>
				))}
			</ul>
		</section>
	)}
</PageLayout>
